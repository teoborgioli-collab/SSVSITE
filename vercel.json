{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/tina/:path*", "destination": "/api/tina?__route=:path*" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/uploads/:path*", "destination": "/api/media-raw?path=:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "images": {
    "sizes": [320, 480, 640, 960, 1280, 1600, 1920],
    "formats": ["image/avif", "image/webp"],
    "minimumCacheTTL": 86400
  },
  "functions": {
    "api/**/*.ts": { "maxDuration": 30 }
  },
  "crons": [{ "path": "/api/rebuild", "schedule": "15 3 * * *" }]
}
