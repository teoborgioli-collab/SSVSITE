---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CmsImage from '../../components/ui/CmsImage.astro';
import Icon from '../../components/ui/Icon.astro';
import Button from '../../components/ui/Button.astro';
import { getEvents, getSettings } from '../../lib/content';
import { formatDate } from '../../lib/dates';

export async function getStaticPaths() {
  const { all } = await getEvents();
  return all.map((event) => ({ params: { slug: event.id }, props: { event } }));
}
const { event } = Astro.props as { event: any };
const { labels } = await getSettings();
const { Content } = await render(event);
const d = event.data;
const isPast = event.end.getTime() < Date.now();
const time = d.startTime ? `${d.startTime}${d.endTime ? `–${d.endTime}` : ''} ${labels.oClock}` : '';
const multiDay = d.endDate && formatDate(d.endDate) !== formatDate(event.start);

// Kalender-Datei (.ics) zum Herunterladen
const icsDate = (dt: Date) => dt.toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, '');
const ics = [
  'BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//SSV Potsdamer Strasse//Website//DE', 'BEGIN:VEVENT',
  `UID:${event.id}@ssvpotsdamerstr.de`, `DTSTAMP:${icsDate(new Date())}`,
  `DTSTART:${icsDate(event.start)}`, `DTEND:${icsDate(event.end)}`,
  `SUMMARY:${(d.title || '').replace(/[,;\n]/g, ' ')}`,
  d.location ? `LOCATION:${d.location.replace(/[,;\n]/g, ' ')}` : '',
  `URL:${new URL(Astro.url.pathname, Astro.site)}`,
  'END:VEVENT', 'END:VCALENDAR',
].filter(Boolean).join('\r\n');
const icsHref = `data:text/calendar;charset=utf-8,${encodeURIComponent(ics)}`;
---
<BaseLayout title={d.seo?.title || d.title} description={d.seo?.description || d.excerpt} image={d.seo?.image || d.image} noindex={d.seo?.noindex}>
  <article>
    <header class={`border-b-[3px] border-ink ${isPast ? 'bg-white' : 'bg-ssv-blue text-white'}`}>
      <div class="container-page grid gap-10 py-12 md:grid-cols-[1.3fr_1fr] md:py-16">
        <div>
          <a href="/veranstaltungen" class="mb-8 inline-flex items-center gap-2 font-bold uppercase tracking-wider hover:underline"><Icon name="arrow-left" size={18} /> {labels.backToEvents}</a>
          {isPast && <p class="eyebrow mb-5">{labels.past}</p>}
          <h1 class="display text-4xl sm:text-5xl md:text-7xl text-balance">{d.title}</h1>
          {d.excerpt && <p class={`mt-6 text-xl font-medium md:text-2xl ${isPast ? 'text-ink/80' : 'text-white/90'}`}>{d.excerpt}</p>}
        </div>
        <dl class="self-start bg-ssv-lime p-6 text-ink brutal-border shadow-brutal md:p-8">
          <div class="mb-4">
            <dt class="text-xs font-bold uppercase tracking-widest">{labels.date}</dt>
            <dd class="text-xl font-bold">
              <time datetime={event.start.toISOString()}>{formatDate(event.start, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })}</time>
              {multiDay && <> – {formatDate(d.endDate)}</>}
            </dd>
          </div>
          {time && <div class="mb-4"><dt class="text-xs font-bold uppercase tracking-widest">{labels.time}</dt><dd class="text-xl font-bold">{time}</dd></div>}
          {d.location && <div class="mb-6"><dt class="text-xs font-bold uppercase tracking-widest">{labels.location}</dt><dd class="text-xl font-bold">{d.location}</dd></div>}
          <div class="flex flex-col gap-3">
            {d.registrationUrl && !isPast && <Button href={d.registrationUrl} variant="primary" arrow>{d.registrationLabel || labels.register}</Button>}
            {!isPast && <Button href={icsHref} variant="outline" size="sm" download={`${event.id}.ics`}><Icon name="calendar-plus" size={16} /> In den Kalender</Button>}
          </div>
        </dl>
      </div>
    </header>
    {d.image && (
      <div class="container-page max-w-5xl pt-10 md:pt-14">
        <div class="aspect-video overflow-hidden bg-ink brutal-border shadow-brutal-lg">
          <CmsImage src={d.image} alt={d.imageAlt} eager sizes="(min-width: 1024px) 1024px, 100vw" class={`h-full w-full object-cover ${isPast ? 'grayscale' : ''}`} />
        </div>
      </div>
    )}
    <div class="container-page max-w-3xl py-12 md:py-16">
      <div class="prose-ssv"><Content /></div>
    </div>
  </article>
</BaseLayout>
