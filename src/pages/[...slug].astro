---
/** Alle im CMS unter „Seiten“ angelegten Seiten – z. B. /ueber-uns, /wohnheim. */
import PageView from '../components/views/PageView.astro';
import { getPages, getPageTranslations } from '../lib/content';

export async function getStaticPaths() {
  const pages = await getPages('de');
  const { deToEn } = await getPageTranslations();
  return pages.map((page) => ({
    params: { slug: page.slug },
    props: { page, en: deToEn.get(page.slug) },
  }));
}
const { page, en } = Astro.props as { page: any; en?: string };
---
<PageView page={page} slug={page.slug} lang="de" alternates={{ de: `/${page.slug}`, en: en ? `/en/${en}` : undefined }} />
