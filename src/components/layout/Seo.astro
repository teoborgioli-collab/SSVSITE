---
interface Props {
  title?: string | null;
  description?: string | null;
  image?: string | null;
  noindex?: boolean | null;
  type?: 'website' | 'article';
  settings: any;
  publishedTime?: Date;
}
const { title, description, image, noindex, type = 'website', settings, publishedTime } = Astro.props;
const seo = settings.seo || {};
const siteName = settings.siteName;
const tpl = seo.titleTemplate || `%s | ${siteName}`;
const fullTitle = !title || title === siteName ? siteName : title.includes(siteName) ? title : tpl.replace('%s', title);
const desc = (description || seo.description || '').slice(0, 300);
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = image || seo.image;
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).toString() : undefined;
---
<title>{fullTitle}</title>
{desc && <meta name="description" content={desc} />}
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}
<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content="de_DE" />
<meta property="og:title" content={fullTitle} />
{desc && <meta property="og:description" content={desc} />}
<meta property="og:url" content={canonical} />
{ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
<meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={fullTitle} />
{desc && <meta name="twitter:description" content={desc} />}
{ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
