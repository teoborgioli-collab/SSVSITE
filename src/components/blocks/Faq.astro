---
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { render } from 'astro:content';
import { getFaq } from '../../lib/content';
const { block } = Astro.props as { block: any };
let items = await getFaq();
if (block.category) items = items.filter((i) => (i.data.category || '').toLowerCase() === block.category.toLowerCase());
if (!block.groupByCategory) items = items.sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));
if (block.limit) items = items.slice(0, block.limit);
const rendered = await Promise.all(items.map(async (i) => ({ item: i, Content: (await render(i)).Content })));
const groups: [string, typeof rendered][] = block.groupByCategory
  ? Object.entries(
      rendered.reduce<Record<string, typeof rendered>>((acc, r) => {
        const k = r.item.data.category || 'Allgemein';
        (acc[k] ||= []).push(r);
        return acc;
      }, {}),
    )
  : [['', rendered]];
const hasHeading = !!block.heading;
---
<section id={block.anchor || undefined} class="bg-paper py-16 md:py-24">
  <div class="container-page max-w-4xl">
    <SectionHeading badge={block.badge} heading={block.heading} intro={block.intro} />
    <div class="space-y-12">
      {groups.map(([cat, list]) => (
        <div>
          {cat && (hasHeading
            ? <h3 class="mb-5 inline-block border-b-4 border-ink pb-1 text-2xl font-bold uppercase">{cat}</h3>
            : <h2 class="mb-5 inline-block border-b-4 border-ink pb-1 text-2xl font-bold uppercase">{cat}</h2>)}
          <div class="space-y-4">
            {list.map(({ item, Content }) => (
              <details class="group bg-white brutal-border [&_summary::-webkit-details-marker]:hidden" name={`faq-${block.anchor || 'list'}`}>
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 text-lg font-bold transition-colors hover:bg-ssv-lime md:p-6 md:text-xl">
                  <span>{item.data.question}</span>
                  <span class="shrink-0 transition-transform duration-200 group-open:rotate-180"><Icon name="chevron-down" size={26} /></span>
                </summary>
                <div class="prose-ssv border-t-[3px] border-ink bg-paper p-5 md:p-6">
                  <Content />
                </div>
              </details>
            ))}
          </div>
        </div>
      ))}
    </div>
    {block.buttonLabel && block.buttonHref && <div class="mt-10"><Button href={block.buttonHref} variant="outline" arrow>{block.buttonLabel}</Button></div>}
  </div>
</section>
