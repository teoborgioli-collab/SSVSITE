---
import Icon from './Icon.astro';
import { isExternal } from '../../lib/content';
interface Props {
  href?: string | null;
  variant?: 'primary' | 'secondary' | 'outline' | 'dark' | string | null;
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  arrow?: boolean;
  type?: 'button' | 'submit';
  [key: string]: any;
}
const { href, variant = 'primary', size = 'md', class: cls = '', arrow = false, type = 'button', ...rest } = Astro.props;
const variants: Record<string, string> = {
  primary: 'bg-ssv-blue text-white hover:bg-ink',
  secondary: 'bg-ssv-lime text-ink hover:bg-white',
  outline: 'bg-white text-ink hover:bg-ssv-lime',
  dark: 'bg-ink text-white hover:bg-ssv-blue',
};
const sizes = { sm: 'px-4 py-2 text-sm', md: 'px-6 py-3.5 text-sm sm:text-base', lg: 'px-8 py-4 text-base sm:text-lg' };
const classes = `inline-flex items-center justify-center gap-2 font-bold uppercase tracking-wider brutal-border brutal-press select-none ${variants[variant || 'primary'] || variants.primary} ${sizes[size]} ${cls}`;
const ext = isExternal(href || '');
const newTab = Astro.currentLocale === 'en' ? '(opens in a new tab)' : '(öffnet in neuem Tab)';
---
{href ? (
  <a href={href} class={classes} {...(ext ? { target: '_blank', rel: 'noopener noreferrer' } : {})} {...rest}>
    <slot />
    {arrow && <Icon name="arrow-right" size={18} />}
    {ext && <span class="sr-only">{newTab}</span>}
  </a>
) : (
  <button type={type} class={classes} {...rest}>
    <slot />
    {arrow && <Icon name="arrow-right" size={18} />}
  </button>
)}
